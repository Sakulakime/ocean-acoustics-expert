+
+      integer function nlastle(edgekm,stepkm,nsteps)
+C     Last step at or before the edge. Use the REAL metre coordinates
+C     of the march, not INT(edgekm/stepkm) near a grid boundary.
+      implicit none
+      integer nsteps,lo,hi,mid
+      real edgekm,stepkm,edge,dzm,zmid
+      edge=edgekm*1000.
+      dzm=stepkm*1000.
+      lo=0
+      hi=nsteps
+      do while (lo.lt.hi)
+        mid=hi-(hi-lo)/2
+        zmid=dzm*float(mid)
+        if (zmid.le.edge) then
+          lo=mid
+        else
+          hi=mid-1
+        end if
+      end do
+      nlastle=lo
+      end
